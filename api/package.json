    "minio": "^8.0.6",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "^7.0.10",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^9.0.0",
